<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DT Chapter 2: Even Stronger - patcher.
    Needs an UndertaleModTool checkout (tag 0.9.2.0) next to it, see ../build.sh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EvenStrongerPatcher</AssemblyName>
    <RootNamespace>EvenStronger</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- UTMT ships its GameSpecificData as loose content; the patcher embeds those files instead -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <UTMT Condition="'$(UTMT)' == ''">$(MSBuildThisFileDirectory)../.utmt</UTMT>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(UTMT)/UndertaleModLib/UndertaleModLib.csproj" />
    <ProjectReference Include="$(UTMT)/Underanalyzer/Underanalyzer/Underanalyzer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the mod itself ships inside the exe -->
    <EmbeddedResource Include="../gml/**/*.gml" LogicalName="gml/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../patches/**/*.es" LogicalName="patches/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../objects.txt" LogicalName="objects.txt" />
    <EmbeddedResource Include="../assets.txt" LogicalName="assets.txt" />
    <EmbeddedResource Include="../transplant.txt" LogicalName="transplant.txt" />
    <EmbeddedResource Include="../music/*.ogg" LogicalName="music/%(Filename)%(Extension)" />
    <!-- UTMT's per-game decompiler definitions, unpacked to a temp folder at run time -->
    <EmbeddedResource Include="$(UTMT)/UndertaleModLib/GameSpecificData/**/*.json" LogicalName="gsd/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
