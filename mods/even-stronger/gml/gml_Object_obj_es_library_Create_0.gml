// Even Stronger opening: no Susie. Noelle showed up for the group project. Then the lab door.
con = 1;
customcon = 0;
drawdoor = 0;
darkbg = 0;
depth = 100000;
xsin = 0;
siner = 0;
amt = 0;
with (obj_npc_facing)
    instance_destroy();
with (obj_npc_room)
    instance_destroy();
global.interact = 1;
global.facing = 2;
foreground = layer_get_id_at_depth(5000);
layer_depth(foreground[0], 900000);
cutscene_master = scr_cutscene_make();
scr_maincharacters_actors();
kr_actor.sprite_index = spr_krisu;
no = 1;
no_actor = instance_create(186, 132, obj_actor);
scr_actor_setup(no, no_actor, "noelle");
no_actor.sprite_index = spr_noelle_walk_left_lw;
c_mus2("volume", 0, 30);
c_wait(30);
c_mus("free");
c_sel(kr);
c_walk_wait("u", 2, 20);
c_wait(15);
c_sel(no);
c_facing("l");
c_speaker("noelle");
c_msgsetloc(0, "\\E2* Oh^1! Kris^1! You actually came!/", "es_lib_1");
c_msgnextloc("\\E0* Eheheh..^1. I thought I'd be doing this whole thing by myself./", "es_lib_2");
c_msgnextloc("\\E1* Susie said she'd be here in five minutes./", "es_lib_3");
c_msgnextloc("\\E6* ..^1. that was an hour ago./%", "es_lib_4");
c_talk_wait();
c_sel(no);
c_walkdirect(176, 138, 12);
c_wait(14);
c_facing("l");
c_speaker("noelle");
c_msgsetloc(0, "\\E1* Berdly's not here either^1, so..^1. I guess it's just us?/", "es_lib_5");
c_msgnextloc("\\E0* I brought notes^1! They're..^1. mostly doodles./", "es_lib_6");
c_msgnextloc("\\EP* Of^1, um^1. Nothing^1. Nobody^1. Just shapes./", "es_lib_7");
c_msgnextloc("\\E9* ...?/", "es_lib_8");
c_msgnextloc("\\E8* Kris^1, stop looking at me like that!/%", "es_lib_9");
c_talk_wait();
c_wait(40);
c_mus2("initloop", "creepydoor.ogg", 0);
c_sel(no);
c_facing("u");
c_wait(30);
c_speaker("noelle");
c_msgsetloc(0, "\\E5* ..^1. Kris^1, do you hear that?/", "es_lib_10");
c_msgnextloc("\\E2* It's coming from the computer lab.../%", "es_lib_11");
c_talk_wait();
c_var_instance(id, "drawdoor", 1);
c_soundplay(snd_locker);
c_wait(50);
c_sel(kr);
c_autofacing(0);
c_walkdirect(140, 105, 30);
c_sel(no);
c_autofacing(0);
c_walkdirect(172, 108, 34);
c_wait(40);
c_sel(no);
c_facing("l");
c_speaker("noelle");
c_msgsetloc(0, "\\EK* K-Kris^1! What IS that!?/", "es_lib_12");
c_msgnextloc("\\E2* It looks like..^1. the inside of a closet...?/", "es_lib_13");
c_msgnextloc("\\EB* You're..^1. not seriously going in there^1, are you?/%", "es_lib_14");
c_talk_wait();
c_sel(kr);
c_autofacing(1);
c_facing("u");
c_wait(30);
c_sel(no);
c_facing("l");
c_speaker("noelle");
c_msgsetloc(0, "\\E6* (Sigh...)/", "es_lib_15");
c_msgnextloc("\\E8* Fine^1. But if I die^1, I'm haunting you./", "es_lib_16");
c_msgnextloc("\\E4* ..^1. Specifically you./%", "es_lib_17");
c_talk_wait();
c_sel(kr);
c_walkdirect(150, 47, 30);
c_sel(no);
c_walkdirect(166, 50, 30);
c_pannable(1);
c_panspeed(0, -1, 39);
c_wait(50);
c_var_instance(id, "con", 2);
