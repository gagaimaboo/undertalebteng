// Even Stronger opening: no Susie. Noelle came for the group project.
// Played in stages so Kris can answer her (stage 1 -> question -> answer + the door).
stage = 1; // 3 once the whole scene has been queued and run, 4 after the fall starts
con = 1;
drawdoor = 0;
darkbg = 0;
depth = 100000;
xsin = 0;
siner = 0;
amt = 0;
with (obj_npc_facing)
    instance_destroy();
with (obj_npc_room)
    instance_destroy();
global.interact = 1;
global.facing = 2;
foreground = layer_get_id_at_depth(5000);
layer_depth(foreground[0], 900000);
cutscene_master = scr_cutscene_make();
scr_maincharacters_actors();
kr_actor.sprite_index = spr_krisu;
no = 1;
no_actor = instance_create(186, 128, obj_actor);
scr_actor_setup(no, no_actor, "noelle");
no_actor.sprite_index = spr_noelle_walk_up_lw;

// cold open
c_mus2("volume", 0, 1);
c_mus("free");
c_fadeout(1);
c_wait(40);
c_speaker("no_name");
c_msgsetloc(0, "* (The school is quiet after the last bell.)/", "es_lib_n1");
c_msgnextloc("* (You came to the library for the group project.)/", "es_lib_n2");
c_msgnextloc("* (Nobody else showed up.)/%", "es_lib_n3");
c_talk_wait();
c_wait(30);
c_msgsetloc(0, "* (...almost nobody.)/%", "es_lib_n4");
c_talk_wait();
c_fadein(45);
c_wait(50);

// she doesn't notice you
c_sel(kr);
c_walk_wait("u", 1, 24);
c_wait(20);
c_speaker("noelle");
c_msgsetloc(0, "\\E1* \"A local legend...\"/", "es_lib_1");
c_msgnextloc("\\E1* (Hmm. Hmm hmm...)/%", "es_lib_2");
c_talk_wait();
c_sel(kr);
c_walk_wait("u", 1, 10);
c_soundplay(snd_wing);
c_sel(no);
c_sprite(spr_noelle_shocked_lw);
c_shakeobj();
c_emote("!", 20);
c_wait(20);
c_speaker("noelle");
c_msgsetloc(0, "\\EK* AH--!!/%", "es_lib_3");
c_talk_wait();
c_facing("l");
c_wait(10);
c_msgsetloc(0, "\\E2* K-Kris!? Oh my gosh^1, you scared me!/", "es_lib_4");
c_msgnextloc("\\E0* Eheheh..^1. you actually came!/", "es_lib_5");
c_msgnextloc("\\E6* I thought I was gonna be doing this whole thing by myself./%", "es_lib_6");
c_talk_wait();
c_sel(no);
c_walkdirect(176, 136, 10);
c_wait(14);
c_facing("l");
c_speaker("noelle");
c_msgsetloc(0, "\\E1* Susie said she'd be here in five minutes./", "es_lib_7");
c_msgnextloc("\\E6* ..^1. that was an hour ago./", "es_lib_8");
c_msgnextloc("\\E5* She texted me^1, um.../", "es_lib_9");
c_msgnextloc("\\E2* \"lol.\"/", "es_lib_10");
c_msgnextloc("\\E1* Just \"lol.\" No capital letters./", "es_lib_11");
c_msgnextloc("\\E9* I don't know what that means in this context./%", "es_lib_12");
c_talk_wait();
c_wait(15);
c_msgsetloc(0, "\\E1* And Berdly said he had a \"prior engagement of great intellectual significance.\"/", "es_lib_13");
c_msgnextloc("\\E8* Which means he's in the computer lab again^1, playing that pinball game./", "es_lib_14");
c_msgnextloc("\\E0* Eheheh.../%", "es_lib_15");
c_talk_wait();
c_wait(20);
c_msgsetloc(0, "\\E0* Anyway^1! I already started!/", "es_lib_16");
c_msgnextloc("\\E1* Ms. Alphys said it has to be about a \"local legend.\"/", "es_lib_17");
c_msgnextloc("\\E2* So I was thinking we could do.../%", "es_lib_18");
c_talk_wait();
c_wait(30);
c_sel(no);
c_facing("d");
c_wait(20);
c_msgsetloc(0, "\\E7* ..^1. the forest./%", "es_lib_19");
c_talk_wait();
c_wait(45);
c_msgsetloc(0, "\\E6* ..^1. no./", "es_lib_20");
c_msgnextloc("\\E6* No^1, never mind^1. Not the forest./%", "es_lib_21");
c_talk_wait();
c_wait(60);
c_sel(no);
c_facing("l");
c_msgsetloc(0, "\\E1* ...Sorry./", "es_lib_22");
c_msgnextloc("\\E6* Dad's still in the hospital^1, so the house is.../", "es_lib_23");
c_msgnextloc("\\E6* Really quiet./", "es_lib_24");
c_msgnextloc("\\E1* I kind of come here so I don't have to hear it./%", "es_lib_25");
c_talk_wait();
c_wait(20);

// the question; the reply comes from scr_es_text(24501) once Kris answers
c_speaker("noelle");
c_msc(24500);
c_talk_wait();
c_speaker("noelle");
c_wait(50);
c_mus2("initloop", "creepydoor.ogg", 0);
c_wait(40);
c_sel(no);
c_facing("u");
c_emote("?", 20);
c_wait(25);
c_msgsetloc(0, "\\E5* ..^1. Kris./", "es_lib_34");
c_msgnextloc("\\E2* Do you hear that?/%", "es_lib_35");
c_talk_wait();
c_sel(no);
c_walkdirect(170, 112, 26);
c_wait(30);
c_msgsetloc(0, "\\E1* Berdly? Is that you in there?/%", "es_lib_36");
c_talk_wait();
c_wait(60);
c_msgsetloc(0, "\\E2* ...Berdly?/%", "es_lib_37");
c_talk_wait();
c_var_instance(id, "drawdoor", 1);
c_soundplay(snd_locker);
c_sel(no);
c_sprite(spr_noelle_shocked_lw);
c_shakeobj();
c_walkdirect(176, 134, 8);
c_wait(50);
c_facing("u");
c_msgsetloc(0, "\\EK* K-Kris^1! What IS that!?/", "es_lib_38");
c_msgnextloc("\\E2* It looks like..^1. the inside of a closet...?/", "es_lib_39");
c_msgnextloc("\\E5* There's no closet in the computer lab!/%", "es_lib_40");
c_talk_wait();
c_sel(kr);
c_autofacing(0);
c_walkdirect(140, 105, 34);
c_wait(40);
c_sel(no);
c_facing("l");
c_msgsetloc(0, "\\EB* Kris!? You're..^1. not seriously going in there^1, are you?/%", "es_lib_41");
c_talk_wait();
c_sel(kr);
c_autofacing(1);
c_facing("u");
c_wait(45);
c_msgsetloc(0, "\\E6* (Sigh...)/", "es_lib_42");
c_msgnextloc("\\E7* My mom always says nothing good happens after the last bell./", "es_lib_43");
c_msgnextloc("\\E8* ...Fine./", "es_lib_44");
c_msgnextloc("\\E8* But if I die^1, I'm haunting you./", "es_lib_45");
c_msgnextloc("\\E4* Specifically you./%", "es_lib_46");
c_talk_wait();
c_sel(no);
c_walkdirect(166, 106, 20);
c_wait(25);
c_facing("u");
c_wait(30);
c_msgsetloc(0, "\\E1* ..^1. okay./", "es_lib_47");
c_msgnextloc("\\E1* For the project./%", "es_lib_48");
c_talk_wait();
c_sel(kr);
c_walkdirect(150, 47, 30);
c_sel(no);
c_walkdirect(166, 50, 30);
c_pannable(1);
c_panspeed(0, -1, 39);
c_wait(50);
c_var_instance(id, "stage", 3);
