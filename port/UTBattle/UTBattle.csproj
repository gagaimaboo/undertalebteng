<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UTBattle</AssemblyName>
    <RootNamespace>UTBattle</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- who made it and which version: an exe with none of this looks suspicious to antivirus heuristics -->
    <Product>Innertale Engine (C# port)</Product>
    <Company>Innertale Engine</Company>
    <Description>Innertale Engine, the UNDERTALE battle engine (C# port)</Description>
    <Copyright>Fan project; UNDERTALE and DELTARUNE by Toby Fox</Copyright>
    <Version>1.4.0</Version>
    <FileVersion>1.4.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <!-- the exported sprites, sounds and font tables are built into the exe -->
  <ItemGroup>
    <EmbeddedResource Include="assets\**\*" LogicalName="assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
